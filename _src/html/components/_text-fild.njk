	<div class="input-group qela-input-group">
		<button class="btn btn-outline-info ic-minus" type="button"></button>
		<input type="number" class="form-control" placeholder="0"/>
		<button class="btn btn-outline-info ic-plus" type="button"></button>
	</div>
	<!-- success -->
	<div class="input-group qela-input-group">
		<button class="btn btn-outline-info ic-minus" type="button"></button>
		<input type="number" class="form-control success" value="2.2" placeholder="0"/>
		<button class="btn btn-outline-info ic-plus" type="button"></button>
	</div>
	<!-- danger -->
