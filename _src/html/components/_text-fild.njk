{% import "html/data/form/_inputData.njk" as data %}
{% from "html/includes/form/input/_formControl.njk" import formControl %}
{% from "html/includes/form/input/_input-search.njk" import inputSearch %}
<!-- Text field  -->
<section class="d-grid gap-3">
	<h2 class="h1 mt-4">Text field</h2>
	<h4>Input</h4>
	{% for item in data.inputsComponent %}
		{{formControl(item)}}
	{% endfor %}
	<!-- Input search custom-->
	<h4 class="mt-4">Input search custom</h4>
	<!-- default -->
	{{inputSearch()}}
	<!-- Textarea -->
	<h4 class="mt-4">Textarea </h4>
	{% for item in data.textareaComponent %}
		{{formControl(item)}}
	{% endfor %}
	<!-- Input group-->
	<h4 class="mt-4">Input group</h4>
	{% for item in data.inputsGroupComponent %}
		{{formControl(item)}}
	{% endfor %}
	{% for item in data.inputsGroupIconComponent %}
		{{formControl(item)}}
	{% endfor %}
	<div class="py-6"></div>

	<!-- Input group Small-->
	<h4 class="mt-4">Input group Small</h4>
	<!-- default -->
	<div>
		<div class="qela-form-labels">
			<div>
				<label for="inputPasswordSm1" class="form-label required">Label</label>
				<button type="button" class="btn btn-sm qela-btn-tooltip ic-help-circle-filled" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-custom-class="custom-tooltip" data-bs-title="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quis lobortis nisl cursus bibendum."></button>
			</div>
			<label class="form-label">hint text</label>
		</div>
		<div class="input-group input-group-sm">
			<div class="qela-input-inner right">
				<input type="password" class="form-control" placeholder="Password" aria-label="Password" id="inputPasswordSm1" aria-describedby="button-addon1"/>
				<button class="btn  ic-eye-close" type="button" id="button-addon1"></button>
			</div>
			<div class="invalid-feedback">Error text</div>
		</div>
		<div class="helper-text">Helper text</div>
	</div>
	<!-- error -->
	<div>
		<div class="qela-form-labels">
			<div>
				<label for="inputPasswordSm2" class="form-label required">Label</label>
