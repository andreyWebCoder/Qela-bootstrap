			<label class="form-label">hint text</label>
		</div>
		<div class="input-group input-group-sm  is-invalid">
			<div class="qela-input-inner right">
				<input type="password" class="form-control is-invalid" placeholder="Password" id="inputPasswordSm2" aria-label="Password" aria-describedby="button-addon2"/>
				<button class="btn ic-eye" type="button" id="button-addon2"></button>
			</div>
			<div class="invalid-feedback">Error text</div>
		</div>
		<div class="helper-text">Helper text</div>
	</div>
