<!-- Multi-select  -->
<section class="d-grid gap-3">
	<h2 class="h1 mt-4">Multi-select</h2>
	<h4>Multi-select</h4>
	<!-- default -->
	<div>
		<label class="form-label required">Select multiple</label>
		<div>
			<v-multi-select v-model="value1" :searchable="true"  :options="options" :multiple="true" :close-on-select="true"></v-multi-select>
		</div>
		<div class="invalid-feedback">Error text</div>
	</div>
	<!-- disabled -->
	<div>
		<label class="form-label required">Select multiple</label>
		<div>
			<v-multi-select v-model="value2" :searchable="true"  :options="options" :multiple="true" :close-on-select="true" :disabled="true"></v-multi-select>
		</div>
		<div class="invalid-feedback">Error text</div>
	</div>
	<!-- error -->
	<div>
		<label class="form-label required">Select multiple</label>
		<div class="is-invalid">
			<v-multi-select v-model="value3" :searchable="true"  :options="options" :multiple="true"></v-multi-select>
		</div>
		<div class="invalid-feedback">Error text</div>
	</div>
	<!-- default select-->
	<h4>Select</h4>
	<div>
		<label class="form-label required">Select</label>
		<div>
			<v-multi-select v-model="value4" :searchable="false"  :options="options" :single="true"></v-multi-select>
		</div>
		<div class="invalid-feedback">Error text</div>
	</div>
	<!-- Small select-->
	<h4>Select multiple small</h4>
	<div>
		<label class="form-label required">
			<small>Select multiple</small>
		</label>
		<div>
			<v-multi-select v-model="value8" :searchable="true"  :options="options" :multiple="true" :close-on-select="true" class='multiselect-sm'></v-multi-select>
		</div>
		<div class="invalid-feedback">Error text</div>
	</div>
</section>