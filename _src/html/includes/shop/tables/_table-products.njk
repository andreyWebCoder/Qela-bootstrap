<div class="table-responsive qela-table position-relative">
	<table class="table table-hover">
		<thead class="table-light">
			<tr>
				<th width="72px">
					<div class="form-check form-check-inline m-0"><input type="checkbox" autocomplete="off" class="form-check-input"></div>
				</th>
				<th width="282px">
					<button type="button" class="btn ico-right ic-arrows-down-up">Назва</button>
				</th>
				<th>
					<button type="button" class="btn ico-right ic-arrows-down-up">Категорія</button>
