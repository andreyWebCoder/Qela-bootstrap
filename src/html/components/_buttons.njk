				type: "secondary",
				classes: "btn-sm ico ic-plus",
				disabled: false
			},{
				button: false,
				type: "info",
				classes: "ico ic-message-circle ms-auto position-relative",
				disabled: false,
				counter:"+10"
			}
		] %}
