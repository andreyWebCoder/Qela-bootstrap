	<!-- Icon buttons -->
	<h4 class="mt-4">Icon buttons</h4>
	<div class="d-flex gap-2 flex-wrap align-items-start">
		{% set buttonsIcData = [
			{
				button: true,
				type: "primary",
				classes: "ico ic-plus",
				disabled: false
			}, {
				button: true,
				type: "secondary",
				classes: "ico ic-plus",
				disabled: false
			},{
				button: true,
