	<!-- Button-close -->
	<h4 class="mt-4">Button-close</h4>
	<div class="d-flex gap-2 flex-wrap">
		<button type="button" class="btn-close ic-cloze" aria-label="Close"></button>
		<button type="button" class="btn-close ic-cloze" disabled aria-label="Close"></button>
	</div>
	<!-- Button-close small-->
	<h4 class="mt-4">Button-close small</h4>
	<div class="d-flex gap-2 flex-wrap">
		<button type="button" class="btn-close  ic-cloze" aria-label="Close"></button>
		<button type="button" class="btn-close  ic-cloze" disabled aria-label="Close"></button>
	</div>
	<!-- Button-icon -->
	<h4 class="mt-4">Button-icon</h4>
	<div class="d-flex gap-2 flex-wrap">
		<button type="button" class="qela-btn-ic ic-search"></button>
		<button type="button" class="qela-btn-ic ic-search" disabled></button>
	</div>
	<!-- Buttons group-->
	<h4 class="mt-4">Buttons group</h4>
	<div>
		<div class="btn-group qela-btn-group" role="group" aria-label="Basic example">
			<button type="button" class="btn btn-info ico ic-plus"></button>
			<button type="button" class="btn btn-info ico ic-plus"></button>
			<button type="button" class="btn btn-info ico ic-plus"></button>
			<button type="button" class="btn btn-info ico ic-plus"></button>
			<button type="button" class="btn btn-info danger ico ic-plus"></button>
		</div>
	</div>
	<div>
		<div class="btn-group-vertical" role="group" aria-label="Vertical button group">
			<button type="button" class="btn btn-outline-info py-0 ico ic-triangle-small"></button>
			<button type="button" class="btn btn-outline-info py-0 ico ic-triangle-inverted-small"></button>
		</div>
	</div>
	<!-- Map buttons  -->
	<h4 class="mt-4">Map buttons</h4>
	<div>
		<div class="btn-group-vertical qela-btn-map position-static" role="group" aria-label="Vertical button group">
			<button type="button" class="btn border-0 ico ic-plus" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-custom-class="qela-tooltip-black" data-bs-title="Zoom Out"></button>
			<button type="button" class="btn border-0 ico ic-minus" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-custom-class="qela-tooltip-black" data-bs-title="Zoom In"></button>
			<button type="button" class="btn border-0 ico ic-arrow-autofit-content" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-custom-class="qela-tooltip-black" data-bs-title="Fit to all poins"></button>
		</div>
	</div>
	<!-- Slide buttons  -->
	<h4 class="mt-4">Slide buttons</h4>
	<div>
		<div class="btn-group qela-btn-slide" role="group">
			<button type="button" class="btn ico ic-chevron-left" disabled></button>
			<button type="button" class="btn ico ic-chevron-right"></button>
		</div>
	</div>
	<!-- Buttons custom  -->
	<h4 class="mt-4">Buttons appstor, googleplay</h4>
	<div class="d-flex gap-2 flex-wrap">
		<button type="button" class="btn btn-apple"><img src="/img/appstore.svg" alt=""></button>
		<button type="button" class="btn btn-google"><img src="/img/googleplay.svg" alt="">
		</button>
	</div>
</section>