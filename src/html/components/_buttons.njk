		{% set buttonsData = [
			{
				button: true,
				type: "primary",
				classes: "",
				text: "Primary",
				disabled: false
			}, {
				button: true,
				type: "primary",
				classes: "",
				text: "Primary",
				disabled: true
			}, {
				button: true,
				type: "primary",
				classes: "ic-plus ico-left",
				text: "Primary",
				disabled: false
			},{
				button: true,
				type: "primary",
				classes: "ic-plus ico-right",
				text: "Primary",
				disabled: false
			},{
				button: true,
				type: "primary",
				classes: "ic-plus ico-right",
				text: "Primary",
				disabled: true
			}
		] %}
		{% from "html/includes/btns/_btn.njk" import btns %}
		{% for bt in buttonsData %}
			{{btns(bt)}}
		{% endfor %}
	</div>
