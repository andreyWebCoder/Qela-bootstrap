	<body class="theme--strichka">
		<script>
			function addDarkClass() {
				try {
					if (localStorage.getItem("theme") === "night-theme") {
						document
							.body
							.classList
							.add("night-theme");
					} else {
						document
							.body
							.classList
							.remove("night-theme");
					}
				} catch (err) {}
			}
			addDarkClass();
		</script>
		<style>
			body,
			html {
				scroll-behavior: smooth;
			}

			.--hide {
				display: none;
			}

			aside.--aside,
			body,
			header {
				transition: background-color 0.25s ease 0s;
			}

			body.night-theme {
				background-color: rgba(0, 0, 0, 0.5);
			}

			body.night-theme header {
				background-color: rgb(0, 0, 0);
				box-shadow: 0 4px 10px rgba(255, 255, 255, 0.2);
				border-color: #6c757d;
			}

			body.night-theme aside.--aside {
				background-color: rgb(0, 0, 0);
				color: #fff;
			}

			body.night-theme aside.--aside a {
				color: #fff;
			}

			* ::-webkit-scrollbar {
				width: 8px;
				height: 8px;
			}

			* scrollbar {
				width: 8px;
				height: 8px;
			}

			* ::-webkit-scrollbar-track {
				background-color: #dee2e6;
				border-radius: 50px;
			}

			* scrollbar-track {
				background-color: #dee2e6;
				border-radius: 50px;
			}

			*::-webkit-scrollbar-thumb {
				background-color: #6c757d;
				border: 2px solid #dee2e6;
				height: 20%;
				border-radius: 50px;
			}

			* scrollbar-thumb {
				background-color: #6c757d;
				border: 2px solid #dee2e6;
				height: 20%;
			}

			main.qela-body {
				padding-left: 220px;
			}

			.--btn::before {
				font-size: 26px !important;
				line-height: 1;
			}

			.--btn svg {
				width: 26px;
				height: 100%;
			}

			.night-theme *::-webkit-scrollbar-track,
			.night-theme::-webkit-scrollbar-track {
				background-color: #343a40;
			}

			.night-theme * scrollbar-track,
			.night-theme scrollbar-track {
				background-color: #343a40;
			}

			.night-theme *::-webkit-scrollbar-thumb,
			.night-theme::-webkit-scrollbar-thumb {
				background-color: #6c757d;
				border: 2px solid #343a40;
			}

			.night-theme * scrollbar-thumb,
			.night-theme scrollbar-thumb {
				background-color: #6c757d;
				border: 2px solid #343a40;
			}

			.night-theme .--btn {
				background-color: rgba(0, 0, 0, 0.5);
			}

			.night-theme .--btn::before {
				color: #fff;
			}

			.night-theme .--btn path {
				fill: #fff;
			}

			.night-theme #toggle-bg::before {
				content: "\e95d";
			}

			.night-theme .--elastic li::before {
				background-color: #9188ff;
			}

			aside.--aside {
				width: 228px;
				height: calc(100% - 56px);
				z-index: 10;
				margin-top: 62px;
				overflow: auto;
				background-color: rgb(255, 255, 255);
				box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);

			}

			aside.--aside a {
				color: #000000;
				text-decoration: none;
				font-size: 14px;
			}

			.btn.--burger {
				display: none;
			}

			.btn.--burger span {
				width: 100%;
				height: 3px;
				background-color: #ffe000;
			}

			.--elastic li {
				list-style: none;
				position: relative;
				padding-left: 25px;
			}

			.--elastic li::before {
				content: "\e936";
				font-family: 'icons';
				position: absolute;
				width: 16px;
				height: 16px;
				border-radius: 50%;
				background-color: #ffe000;
				left: 0;
				top: 4px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: inherit;
				font-size: 16px;
				line-height: 1;
				transition: background-color 0.3s ease 0s;
			}

			.--elastic a {
				transition: all 0.3s ease 0s;
			}

			/* .link--active{
            color: red !important;
        } */
			section > h2 {
				background-color: rgba(28, 109, 12, 0.7);
				padding: 5px;
			}

			section > h4 {
				border-bottom: 2px solid rgba(109, 31, 12, 0.7);
				padding: 5px;
			}

			@media (max-width: 1240px) {
				aside.--aside {
					left: 150%;
				}

				aside.--aside.active {
					left: 0;
				}

				.btn.--burger {
					display: flex;
					flex-direction: column;
					justify-content: center;
					width: 36px;
					height: 36px;
					gap: 8px;
					padding: 2px;
					margin-left: 4px;
				}

				main.qela-body {
					padding-left: 0;
				}
			}
		</style>
